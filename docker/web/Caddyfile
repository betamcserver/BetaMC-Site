:80 {
    root * /srv
    encode zstd gzip

    @trailingSlash path_regexp trailingSlash ^(.+)/$
    redir @trailingSlash {re.trailingSlash.1}{?query} 301

    try_files {path} {path}.html {path}

    templates
    file_server

    @wiki path_regexp wiki ^/wiki(/.*)?$
    redir @wiki {env.WIKI_URL}{re.wiki.1} 301

    @ratgame path /ratgame*
    redir @ratgame {env.RATGAME_URL} 301

    handle_errors {
        @404 expression {http.error.status_code} == 404
        rewrite @404 /404.html

        templates
        file_server
    }
}
